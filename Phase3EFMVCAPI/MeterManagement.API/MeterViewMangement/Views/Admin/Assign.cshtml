@model AssignMeterViewModel

<div class="container py-5 animate slideIn">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0" style="border-radius: 15px;">
                <div class="card-header bg-warning text-dark py-3 text-center" style="border-radius: 15px 15px 0 0;">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-user-tag me-2"></i>Assign Meter to Agent</h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-info border-0 shadow-sm mb-4">
                        <small class="d-block text-muted uppercase fw-bold">Meter Serial</small>
                        <h5 class="mb-0 fw-bold">@Model.SerialNumber</h5>
                    </div>

                    <form asp-action="Assign" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MeterId" />
                        <input type="hidden" asp-for="SerialNumber" />

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-bold small text-uppercase text-muted">Agent Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-envelope text-warning"></i></span>
                                <input asp-for="Email" class="form-control form-control-lg border-start-0 shadow-none"
                                       placeholder="example@elsewedy.com" required />
                            </div>
                            <div class="form-text mt-2">
                                <i class="fas fa-info-circle me-1"></i> Make sure the user has the <strong>Agent</strong> role.
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning btn-lg fw-bold shadow-sm hover-up">
                                Confirm Assignment
                            </button>
                            <a asp-action="GetAll" class="btn btn-link text-muted text-decoration-none">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>