@model DeleteMeterViewModel

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <i class="fas fa-exclamation-triangle text-danger fa-4x"></i>
                    </div>
                    <h3 class="fw-bold text-dark">Are you sure?</h3>
                    <p class="text-muted">
                        You are about to permanently delete meter
                        <strong class="text-dark">@Model.SerialNumber</strong>.
                        This action cannot be undone!
                    </p>

                    <form asp-action="ExecuteDelete" asp-route-id="@Model.Id" method="post">
                        <div class="d-grid gap-2 d-md-flex justify-content-center mt-4">
                            <a asp-action="GetAll" class="btn btn-light px-5 border">Cancel</a>
                            <button type="submit" class="btn btn-danger px-5 shadow-sm">Confirm Delete</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>