@model MeterCreateViewModel

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white p-4">
                    <h4 class="mb-0"><i class="fas fa-layer-group me-2"></i>Bulk Import Meters</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CreateBulk" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Enter Serial Numbers (One per line):</label>
                            <textarea asp-for="SerialNumber" class="form-control" rows="10"
                                      placeholder="SN10001&#10;SN10002&#10;SN10003"></textarea>
                            <span asp-validation-for="SerialNumber" class="text-danger small"></span>
                        </div>

                        <div class="alert alert-info py-2">
                            <small><i class="fas fa-info-circle me-1"></i> Existing serials will be automatically skipped.</small>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-5">
                                <i class="fas fa-upload me-2"></i> Process Bulk
                            </button>
                            <a asp-action="GetAll" class="btn btn-light">Back to List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>