@model DeleteMeterViewModel

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <i class="fas fa-pause-circle text-warning fa-4x"></i>
                    </div>
                    <h3 class="fw-bold text-dark">Deactivate Meter?</h3>
                    <p class="text-muted">
                        You are about to deactivate meter: <br />
                        <strong class="text-dark">@Model.SerialNumber</strong>
                    </p>
                    <div class="alert alert-info small border-0">
                        <i class="fas fa-info-circle me-1"></i>
                        This meter will be hidden from the inventory but kept in the database.
                    </div>

                    <form asp-action="ExecuteSoftDelete" asp-route-id="@Model.Id" method="post">
                        <div class="d-grid gap-2 d-md-flex justify-content-center mt-4">
                            <a asp-action="GetAll" class="btn btn-light px-5 border">Cancel</a>
                            <button type="submit" class="btn btn-warning px-5 shadow-sm text-dark fw-bold">Confirm Deactivation</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>