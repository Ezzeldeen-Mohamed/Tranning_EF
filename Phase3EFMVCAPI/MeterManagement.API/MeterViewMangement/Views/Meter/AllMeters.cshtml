@model List<MeterViewModel>

<h2>All Meters</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}


<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Serial</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var meter in Model)
        {
            <tr class="clickable-row"
                onclick="window.location='@Url.Action("Details", new { id = meter.Id })'">

                <td>@meter.Id</td>
                <td>@meter.SerialNumber</td>

                <td>
                    <span class="badge @(meter.Status == "Installed" ? "bg-success" : meter.Status == "Assigned" ? "bg-warning text-dark" : "bg-info text-dark")">
                        @meter.Status
                    </span>
                </td>
                <td class="text-center align-middle">
                    <!-- ❌ مهم: نوقف propagation -->
                    <form asp-action="Delete" asp-route-id="@meter.Id" method="post"
                          onclick="event.stopPropagation();">

                        <button class="btn btn-danger px-2 py-1"
                                style="font-size: 16px; border-radius: 8px;">
                            <i class="fas fa-trash me-1"></i> Delete
                        </button>

                    </form>
                </td>

            </tr>
        }
    </tbody>
</table>


<style>
    .clickable-row {
        cursor: pointer;
        transition: 0.2s;
    }

        .clickable-row:hover {
            background-color: #e9f5ff;
            transform: scale(1.01);
        }
</style>