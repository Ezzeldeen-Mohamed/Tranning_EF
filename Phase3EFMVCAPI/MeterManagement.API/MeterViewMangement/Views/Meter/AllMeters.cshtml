@model PagedMetersViewModel

<div class="container-fluid py-4 animate slideIn">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark mb-0"><i class="fas fa-microchip me-2"></i>Meter Inventory</h2>

        <div class="btn-group shadow-sm">
            <a asp-action="Create" class="btn btn-success">
                <i class="fas fa-plus me-1"></i> Single
            </a>
            <a asp-action="CreateBulk" class="btn btn-info text-white">
                <i class="fas fa-list me-1"></i> Bulk Text
            </a>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#importExcelModal">
                <i class="fas fa-file-excel me-1"></i> Excel
            </button>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm alert-dismissible fade show" role="alert">
            <i class="fas fa-times-circle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body bg-light rounded">
            <form method="get" asp-action="GetAll" class="row g-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="serialNumber" value="@Model.SerialFilter" class="form-control border-start-0" placeholder="Search Serial..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="OnStock" selected="@(Model.StatusFilter == "OnStock")">On Stock</option>
                        <option value="Assigned" selected="@(Model.StatusFilter == "Assigned")">Assigned</option>
                        <option value="Installed" selected="@(Model.StatusFilter == "Installed")">Installed</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">Filter</button>
                    <a asp-action="GetAll" class="btn btn-outline-secondary px-4">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4 py-3">ID</th>
                        <th class="py-3">Serial Number</th>
                        <th class="py-3">Status</th>
                        <th class="py-3 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var meter in Model.Items)
                    {
                        <tr class="@(meter.IsDeleted ? "table-secondary text-muted" : "clickable-row")">
                            <td class="ps-4 fw-bold">#@meter.Id</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-microchip me-2 @(meter.IsDeleted ? "text-muted" : "text-primary")"></i>
                                    <span class="@(meter.IsDeleted ? "text-decoration-line-through" : "fw-bold")">@meter.SerialNumber</span>
                                    @if (meter.IsDeleted)
                                    {
                                        <span class="badge bg-dark ms-2" style="font-size: 0.65rem;">ARCHIVED</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="badge rounded-pill @(meter.IsDeleted ? "bg-secondary" : meter.Status == "Installed" ? "bg-success" : meter.Status == "Assigned" ? "bg-warning text-dark" : "bg-info")" style="font-size: 0.8rem;">
                                    @(meter.IsDeleted ? "Deleted" : meter.Status)
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-controller="Meter"
                                       asp-action="Details"
                                       asp-route-id="@meter.Id"
                                       class="btn btn-light btn-sm border shadow-sm rounded-pill px-4 py-3">

                                        <i class="fas fa-eye me-1"></i>
                                        Details
                                    </a>

                                    @if (meter.IsDeleted || meter.Status == "Deleted")
                                    {
                                        <form asp-action="Restore" asp-route-id="@meter.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success btn-sm px-3 rounded-pill shadow-sm hover-up">
                                                <i class="fas fa-trash-restore"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <div class="dropdown float-end m-3">
                                            <button type="button"
                                                    class="btn btn-light btn-sm border shadow-sm dropdown-toggle rounded-pill px-3"
                                                    data-bs-toggle="dropdown">
                                                <i class="fas fa-cog me-1"></i> Actions
                                            </button>

                                            <ul class="dropdown-menu dropdown-menu-end shadow border-0">

                                                @if (meter.Status == "OnStock")
                                                {
                                                    <li>
                                                        <a asp-controller="Meter"
                                                           asp-action="Assign"
                                                           asp-route-id="@meter.Id"
                                                           asp-route-serialNumber="@meter.SerialNumber"
                                                           class="dropdown-item py-2 text-warning fw-bold">
                                                            <i class="fas fa-user-plus me-2"></i>
                                                            Assign to Agent
                                                        </a>
                                                    </li>
                                                    <li><hr class="dropdown-divider"></li>
                                                }
                                                <li>
                                                    <a asp-controller="Meter"
                                                       asp-action="Update"
                                                       asp-route-id="@meter.Id"
                                                       class="dropdown-item py-2">
                                                        <i class="fas fa-edit text-primary me-2"></i>
                                                        Edit Serial
                                                    </a>
                                                </li>

                                                <li><hr class="dropdown-divider"></li>

                                                <li>
                                                    <a asp-controller="Meter"
                                                       asp-action="ConfirmSoftDelete"
                                                       asp-route-id="@meter.Id"
                                                       class="dropdown-item py-2 text-warning">
                                                        <i class="fas fa-archive me-2"></i>
                                                        Move to Archive
                                                    </a>
                                                </li>

                                                <li>
                                                    <a asp-controller="Meter"
                                                       asp-action="ConfirmDelete"
                                                       asp-route-id="@meter.Id"
                                                       class="dropdown-item py-2 text-danger">
                                                        <i class="fas fa-trash-alt me-2"></i>
                                                        Permanent Delete
                                                    </a>
                                                </li>

                                            </ul>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link shadow-sm" asp-action="GetAll"
                           asp-route-pageNumber="@i"
                           asp-route-serialNumber="@Model.SerialFilter"
                           asp-route-status="@Model.StatusFilter">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<style>
    .animate.slideIn {
        animation: slideIn 0.5s ease-out forwards;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .hover-up {
        transition: all 0.2s ease;
    }

        .hover-up:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1) !important;
        }

    .clickable-row {
        transition: background-color 0.2s ease;
    }

        .clickable-row:hover {
            background-color: #f8f9fa !important;
        }

    .dropdown-menu {
        border-radius: 15px;
        padding: 10px;
    }

    .dropdown-item {
        border-radius: 8px;
        margin-bottom: 2px;
    }

    .page-link {
        border: none;
        margin: 0 3px;
        border-radius: 8px !important;
        color: #2c3e50;
    }

    .page-item.active .page-link {
        background-color: #2c3e50;
        border-color: #2c3e50;
    }

    .simple-btn {
        display: inline-block;
        padding: 6px 14px;
        border: 1px solid #ccc;
        border-radius: 20px; 
        background-color: white;
        color: #333;
        text-decoration: none;
        font-size: 14px;
        transition: all 0.2s ease;
    }
        
        .simple-btn:hover {
            background-color: #e9ecef;
            border-color: #999;
            color: #000;
            transform: translateY(-1px);
        }

    .btn-light {
        transition: all 0.2s ease;
    }

        .btn-light:hover {
            background-color: #f1f1f1;
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }
</style>