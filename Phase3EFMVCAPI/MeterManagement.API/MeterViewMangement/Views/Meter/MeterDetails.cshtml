@model MeterViewModel

<section class="vh-100" style="background-color: #f4f7f6;">
    <div class="container py-5 h-100">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col col-xl-10">
                <div class="card" style="border-radius: 1rem; border: none; shadow: 0 4px 15px rgba(0,0,0,0.1);">
                    <div class="row g-0">
                        <!-- صورة جمالية للمنتج أو الميتر -->
                        <div class="col-md-6 col-lg-5 d-none d-md-block">
                            <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-login-form/img2.webp"
                                 alt="Meter Details" class="img-fluid" style="border-radius: 1rem 0 0 1rem; height: 100%; object-fit: cover;" />
                        </div>

                        <div class="col-md-6 col-lg-7 d-flex align-items-center">
                            <div class="card-body p-4 p-lg-5 text-black">

                                <div class="d-flex align-items-center mb-3 pb-1">
                                    <i class="fas fa-tachometer-alt fa-2x me-3" style="color: #ff6219;"></i>
                                    <span class="h1 fw-bold mb-0">Meter Info</span>
                                </div>

                                <h5 class="fw-normal mb-3 pb-3" style="letter-spacing: 1px;">Detailed Information for Unit #@Model.Id</h5>

                                <div class="mb-4">
                                    <p class="text-muted mb-1">Serial Number</p>
                                    <h4 class="fw-bold">@Model.SerialNumber</h4>
                                </div>

                                <div class="mb-4">
                                    <p class="text-muted mb-1">Current Status</p>

                                    @if (Model.Status?.ToString() == "Installed")
                                    {
                                        <h4 class="text-success"><i class="fas fa-check-circle"></i> Installed & Operational</h4>
                                    }
                                    else if (Model.Status?.ToString() == "OnStock")
                                    {
                                        <h4 class="text-info"><i class="fas fa-warehouse"></i> Available on Stock</h4>
                                    }
                                    else if (Model.Status?.ToString() == "Assigned")
                                    {
                                        <h4 class="text-warning"><i class="fas fa-user-tag"></i> Assigned to Agent</h4>
                                    }
                                    else
                                    {
                                        <h4 class="text-danger"><i class="fas fa-exclamation-triangle"></i> @Model.Status</h4>
                                    }
                                </div>

                                <hr />

                                <div class="pt-1 mb-4">
                                    <a asp-action="GetAll" class="btn btn-dark btn-lg btn-block">
                                        <i class="fas fa-arrow-left"></i> Back to List
                                    </a>
                                    <button class="btn btn-info btn-lg btn-block" type="button">
                                        <i class="fas fa-edit"></i> Edit Meter
                                    </button>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>