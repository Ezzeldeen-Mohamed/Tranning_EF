@model MeterViewModel

<section class="vh-100" style="background-color: #f4f7f6;">
    <div class="container py-5 h-100">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col col-xl-10">
                <div class="card shadow-lg position-relative" style="border-radius: 1rem; border: none;">

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="position-absolute" style="top: 20px; right: 20px; z-index: 10;">
                            <div class="dropdown">
                                <button type="button" class="btn btn-light btn-sm border shadow-sm dropdown-toggle rounded-pill px-3" data-bs-toggle="dropdown">
                                    <i class="fas fa-cog me-1"></i> Actions
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 animate slideIn">

                                    @if (Model.Status?.ToString() == "OnStock")
                                    {
                                        <li>
                                            <a asp-controller="Meter"
                                               asp-action="Assign"
                                               asp-route-id="@Model.Id"
                                               asp-route-serialNumber="@Model.SerialNumber"
                                               class="dropdown-item py-2 text-warning fw-bold">
                                                <i class="fas fa-user-plus me-2"></i>
                                                Assign to Agent
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li>
                                        <a asp-action="Update" asp-route-id="@Model.Id" class="dropdown-item py-2 text-primary">
                                            <i class="fas fa-edit me-2"></i> Edit Serial
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a asp-action="ConfirmSoftDelete" asp-route-id="@Model.Id" class="dropdown-item py-2 text-warning">
                                            <i class="fas fa-archive me-2"></i> Move to Archive
                                        </a>
                                    </li>
                                    <li>
                                        <a asp-action="ConfirmDelete" asp-route-id="@Model.Id" class="dropdown-item py-2 text-danger">
                                            <i class="fas fa-trash-alt me-2"></i> Permanent Delete
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }

                    <div class="row g-0">
                        <div class="col-md-6 col-lg-5 d-none d-md-block">
                            <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-login-form/img2.webp"
                                 alt="Meter Details" class="img-fluid" style="border-radius: 1rem 0 0 1rem; height: 100%; object-fit: cover;" />
                        </div>

                        <div class="col-md-6 col-lg-7 d-flex align-items-center">
                            <div class="card-body p-4 p-lg-5 text-black">

                                <div class="d-flex align-items-center mb-3 pb-1">
                                    <i class="fas fa-tachometer-alt fa-2x me-3" style="color: #ff6219;"></i>
                                    <span class="h1 fw-bold mb-0">Meter Info</span>
                                </div>

                                <h5 class="fw-normal mb-3 pb-3" style="letter-spacing: 1px;">Detailed Information for Unit #@Model.Id</h5>

                                <div class="mb-4">
                                    <p class="text-muted mb-1 small uppercase fw-bold">Serial Number</p>
                                    <h4 class="fw-bold text-primary">@Model.SerialNumber</h4>
                                </div>

                                <div class="mb-4">
                                    <p class="text-muted mb-1 small uppercase fw-bold">Current Status</p>
                                    @if (Model.Status?.ToString() == "Installed")
                                    {
                                        <h4 class="text-success"><i class="fas fa-check-circle me-2"></i>Installed & Operational</h4>
                                    }
                                    else if (Model.Status?.ToString() == "OnStock")
                                    {
                                        <h4 class="text-info"><i class="fas fa-warehouse me-2"></i>Available on Stock</h4>
                                    }
                                    else if (Model.Status?.ToString() == "Assigned")
                                    {
                                        @if (User.IsInRole("Agent"))
                                        {
                                            <h4 class="text-warning"><i class="fas fa-user-check me-2"></i>Assigned to You</h4>
                                        }
                                        else
                                        {
                                            <h4 class="text-warning"><i class="fas fa-user-tag me-2"></i>Assigned to Agent</h4>
                                        }
                                    }
                                </div>

                                <hr class="my-4" />

                                <div class="d-flex gap-3">
                                    <a href="javascript:void(0);" onclick="history.back();" class="btn btn-outline-secondary px-4">
                                        <i class="fas fa-arrow-left me-1"></i> Back
                                    </a>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-outline-primary px-4 shadow-sm">
                                            <i class="fas fa-edit me-2"></i>Edit Meter
                                        </a>
                                    }

                                    @if (User.IsInRole("Agent") && Model.Status?.ToString() == "Assigned")
                                    {
                                        <form asp-action="Install" asp-controller="Agent" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="meterId" value="@Model.Id" />

                                            <button type="submit" class="btn btn-success px-4 shadow-sm">
                                                <i class="fas fa-tools me-2"></i> Install This Meter
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>