<div class="container py-5">
    <div class="row mb-4">
        <div class="col">
            <h2 class="text-success"><i class="fas fa-user-tie"></i> Agent Workspace</h2>
        </div>
        <div class="col text-end">
            <span class="badge bg-success p-2">Status: Online</span>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow border-0 p-3">
                <div class="d-flex align-items-center">
                    <div class="icon-box bg-success text-white p-3 rounded-3 me-3">
                        <i class="fas fa-boxes fa-2x"></i>
                    </div>
                    <div>
                        <h5 class="mb-0">My Assigned Meters</h5>
                        <p class="text-muted mb-0">View meters assigned to you for installation.</p>
                        <a asp-controller="Agent" asp-action="MyMeters" class="btn btn-link text-success p-0 mt-2">View List <i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>