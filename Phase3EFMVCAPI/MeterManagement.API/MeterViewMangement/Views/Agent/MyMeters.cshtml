@model List<GetAssignedMetersViewModel>

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0"><i class="fas fa-microchip me-2"></i>My Assigned Meters</h3>
            <span class="badge bg-light text-primary">Total: @Model.Count</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Serial Number</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    No meters assigned to you yet.
                                </td>
                            </tr>
                        }
                        @foreach (var meter in Model)
                        {
                            <tr>
                                <td class="ps-4">#@meter.Id</td>
                                <td class="fw-bold">@meter.SerialNumber</td>
                                <td>
                                    <span class="badge rounded-pill bg-info">@meter.Status</span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-controller="Meter" asp-route-id="@meter.Id" class="btn btn-sm btn-outline-primary rounded-pill">
                                        <i class="fas fa-info-circle"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>